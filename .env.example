# Development values only. Replace all secrets before any public deployment.
APP_ENV=development
POSTGRES_DB=nover
POSTGRES_USER=nover
POSTGRES_PASSWORD=local-development-password-change-me
DB_HOST_PORT=5433

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
OPERATOR_TOKEN_KEY=local-operator-token-key-change-me-0123456789
REDEEM_HMAC_KEY=local-redeem-hmac-key-change-me-0123456789
ACCESS_TOKEN_KEY=local-access-token-key-change-me-0123456789

MAX_UPLOAD_BYTES=524288000
STORAGE_DIR=/var/lib/nover/files
